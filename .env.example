# Database -------------------------------------------------------------------
# Local fallback (docker-compose above) is used when this is unset.
# For production, set this to your Neon connection string, e.g.:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/swifttill?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swifttill"

# Image storage --------------------------------------------------------------
# Leave blank to store uploaded menu images locally under apps/web/public/uploads.
# For production, set Cloudinary credentials and the app will upload there.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SwiftTill POS"
# Public base URL used for PWA scope / manifest. For Cloudflare Pages + your
# domain set this to e.g. https://desie.cloud
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Cloudflare Pages -----------------------------------------------------------
# On Cloudflare Pages, set these as build/env variables (DATABASE_URL and the
# CLOUDINARY_* values are SECRETS -> `npx wrangler pages secret put DATABASE_URL`):
#   NEXT_PUBLIC_BASE_URL = https://desie.cloud
#   NEXT_PUBLIC_APP_NAME = SwiftTill POS
#   DATABASE_URL         = postgresql://... (Supabase pooler, ?sslmode=require)
#   CLOUDINARY_CLOUD_NAME / API_KEY / API_SECRET  (or leave blank for local uploads)

